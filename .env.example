# ====================================
# APPLICATION CONFIGURATION
# ====================================
APP_ENV=dev
APP_PORT=8080
APP_HOST=0.0.0.0
APP_SECRET=your-super-secret-key-change-this-in-production

# ====================================
# DATABASE CONFIGURATION
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=pos_kopitiam
DB_SSL_MODE=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ====================================
# REDIS CONFIGURATION (Cache & Queue)
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3

# ====================================
# JWT CONFIGURATION
# ====================================
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# ====================================
# BIGCAPITAL INTEGRATION
# ====================================
BIGCAPITAL_ENABLED=false
BIGCAPITAL_BASE_URL=https://api.bigcapital.ly
BIGCAPITAL_API_KEY=your-bigcapital-api-key
BIGCAPITAL_ORG_ID=your-organization-id
BIGCAPITAL_SYNC_ENABLED=true
BIGCAPITAL_SYNC_INTERVAL=5m

# Bigcapital Chart of Accounts (COA) Mapping
BIGCAPITAL_COA_SALES_ACCOUNT=4000
BIGCAPITAL_COA_CASH_ACCOUNT=1000
BIGCAPITAL_COA_TAX_ACCOUNT=2200
BIGCAPITAL_COA_DISCOUNT_ACCOUNT=5100

# ====================================
# LOGGER CONFIGURATION
# ====================================
LOG_LEVEL=info
LOG_FORMAT=json

# ====================================
# ASYNQ WORKER CONFIGURATION
# ====================================
ASYNQ_REDIS_ADDR=localhost:6379
ASYNQ_CONCURRENCY=10
ASYNQ_MAX_RETRIES=5

# ====================================
# TAX & CHARGES
# ====================================
TAX_RATE=10
SERVICE_CHARGE_RATE=0

# ====================================
# PAGINATION
# ====================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ====================================
# CORS CONFIGURATION
# ====================================
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ====================================
# FEATURE FLAGS
# ====================================
FEATURE_RESERVATION=true
FEATURE_SPLIT_BILL=true
FEATURE_KDS=true
FEATURE_AUDIT_LOG=true
