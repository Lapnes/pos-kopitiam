### ─────────────────────────────────────────────────────────────
### PHASE 9: MASTER DATA — RECIPES / BOM (Manager Only)
### ─────────────────────────────────────────────────────────────
### NOTE: Menu index [0] = Kopi Susu (Bar station)
###       Menu index [4] = Nasi Lemak (Kitchen station)
###       Set is_recipe_based = true on the Menu before creating a Recipe.
### ─────────────────────────────────────────────────────────────

### 9.1 Create Recipe (BOM) — linked to menu[0]
# @name createRecipe
POST http://localhost:8080/api/v1/inventory/recipes
Authorization: Bearer {{loginManager.response.body.data.access_token}}
Content-Type: application/json

{
  "menu_id": "{{getMenus.response.body.data[0].id}}",
  "ingredients": [
    {
      "raw_material_id": "{{createRawMaterial.response.body.data.id}}",
      "quantity": 20
    }
  ]
}

### 9.2 Get Recipe by Menu ID
# @name getRecipeByMenuId
GET http://localhost:8080/api/v1/inventory/recipes/{{getMenus.response.body.data[0].id}}
Authorization: Bearer {{loginManager.response.body.data.access_token}}

### 9.3 Update Recipe
# @name updateRecipe
PUT http://localhost:8080/api/v1/inventory/recipes/{{createRecipe.response.body.data.id}}
Authorization: Bearer {{loginManager.response.body.data.access_token}}
Content-Type: application/json

{
  "menu_id": "{{getMenus.response.body.data[0].id}}",
  "ingredients": [
    {
      "raw_material_id": "{{createRawMaterial.response.body.data.id}}",
      "quantity": 25
    }
  ]
}

### 9.4 Delete Recipe
# @name deleteRecipe
DELETE http://localhost:8080/api/v1/inventory/recipes/{{createRecipe.response.body.data.id}}
Authorization: Bearer {{loginManager.response.body.data.access_token}}


